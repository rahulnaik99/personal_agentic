# ---- App ----
ENV=dev
LOG_LEVEL=INFO
LOG_JSON=true

# ---- LLM provider selection (multi-provider: openai | anthropic | local) ----
LLM_PROVIDER=anthropic
LLM_MODEL=claude-sonnet-4-6

OPENAI_API_KEY=sk-REPLACE_ME
OPENAI_MODEL_FALLBACK=gpt-4o-mini

ANTHROPIC_API_KEY=sk-ant-REPLACE_ME
ANTHROPIC_MODEL_FALLBACK=claude-sonnet-4-6

LOCAL_LLM_BASE_URL=http://localhost:11434/v1
LOCAL_LLM_API_KEY=not-needed
LOCAL_MODEL_FALLBACK=llama3.1

# ---- Generation params ----
TEMPERATURE=0.2
TOP_P=0.9
TOP_K=5
MAX_TOKENS=1024

# ---- Embeddings (bi-encoder) ----
EMBEDDING_PROVIDER=sentence_transformers
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
EMBEDDING_API_KEY=
EMBEDDING_DIM=384

# ---- Reranker ----
RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
RERANKER_TOP_N=5

# ---- Retrieval tuning ----
RETRIEVAL_TOP_K_DENSE=20
RETRIEVAL_TOP_K_SPARSE=20
RRF_K=60
MMR_LAMBDA=0.5
MMR_TOP_K=10
FINAL_TOP_K=5

# ---- Parent-child chunking ----
CHILD_CHUNK_SIZE=400
CHILD_CHUNK_OVERLAP=50
PARENT_CHUNK_SIZE=2000
PARENT_CHUNK_OVERLAP=200

# ---- Weaviate ----
# Overridden per-service in docker-compose.yml (weaviate:8080 inside the
# network); these are the localhost defaults for running services outside Docker.
WEAVIATE_URL=http://localhost:8080
WEAVIATE_GRPC_URL=localhost:50051
WEAVIATE_API_KEY=
WEAVIATE_CLASS_CHILD=ChildChunk
WEAVIATE_CLASS_PARENT=ParentChunk

# ---- Tool agent ----
WEB_SEARCH_PROVIDER=duckduckgo
WEB_SEARCH_MAX_RESULTS=5
URL_FETCH_TIMEOUT_SECONDS=15
URL_FETCH_MAX_CHARS=8000
TOOL_ALLOWED_DOMAINS=

# ---- RAGAS evaluation ----
RAGAS_ENABLED=true
RAGAS_LLM_MODEL=
RAGAS_REGRESSION_TOLERANCE=0.03

# ---- Guardrails ----
GUARDRAILS_ENABLED=true
GUARDRAILS_MAX_INPUT_CHARS=4000
GUARDRAILS_BLOCK_ON_PII_INPUT=true
GUARDRAILS_BLOCK_ON_PII_OUTPUT=false
GUARDRAILS_LOW_FAITHFULNESS_THRESHOLD=0.5

# ---- PDF ingestion ----
UNSTRUCTURED_PDF_STRATEGY=hi_res
INGESTION_IMAGE_DIR=./data/ingested_images
VISION_CAPTION_MODEL_PROVIDER=anthropic

# ---- gRPC service endpoints ----
# Defaults below are for running all services locally without Docker;
# docker-compose.yml overrides the *_GRPC_HOST values to service names.
RAG_AGENT_GRPC_HOST=localhost
RAG_AGENT_GRPC_PORT=50061
# The RAG agent's HTTP ingest API — used by the orchestrator's /status
# endpoint to check Weaviate connectivity (only the RAG agent talks to
# Weaviate directly). docker-compose.yml overrides this to the service name.
RAG_AGENT_INGEST_URL=http://localhost:8001
TOOL_AGENT_GRPC_HOST=localhost
TOOL_AGENT_GRPC_PORT=50062
GRPC_CALL_TIMEOUT_SECONDS=60

# ---- Orchestrator API (external HTTP/SSE gateway) ----
API_HOST=0.0.0.0
API_PORT=8000
CORS_ORIGINS=*
